{
  "name": "discord-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "authorize": "bun run scripts/authorize.ts",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "check": "biome check .",
    "build": "bun run typecheck && bun run check && bun build ./src/index.ts --target=bun > /dev/null"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "dependencies": {
    "@jsquash/webp": "^1.5.0",
    "discord.js": "^14.26.4",
    "elysia": "^1.4.29",
    "image-size": "^2.0.2",
    "ipaddr.js": "^2.4.0",
    "jimp": "^1.6.1",
    "wink-lemmatizer": "^3.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
