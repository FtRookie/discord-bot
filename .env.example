# Local development only. On the server these live in /etc/discord-bot.env (root:root, 0600), and there must
# be no .env in WorkingDirectory — bun would auto-load that too, leaving two sources of truth.

# Developer Portal → your app → Bot.
DISCORD_TOKEN=

# Open Cloud key for the universe. Needs user-restrictions read and write (/ban, /unban, /banlog),
# universe-messaging-service:publish (commands to live servers), and universe:write (the restart rollout).
ROBLOX_API_KEY=

# Reads the changelog repo's UpdateLogs.ts; contents read access is enough.
GITHUB_TOKEN=

# Bearer the game sends when POSTing acknowledgements — must match the value the game holds.
GAME_SHARED_SECRET=

# Everything below is only for per-role command visibility. Leave it blank and the bot skips that sync
# silently; you then grant visibility by hand in Server Settings → Integrations.

# `bun run authorize` only — at runtime the bot reads its own application id from the gateway.
DISCORD_CLIENT_ID=

# Read when the bot exchanges the refresh token on startup, and by `bun run authorize`.
DISCORD_CLIENT_SECRET=

# Optional, seeds a deploy that has no oauth.json yet. Discord rotates the refresh token, so this value is
# spent after one startup and oauth.json (0600) is the live copy from then on.
DISCORD_REFRESH_TOKEN=
